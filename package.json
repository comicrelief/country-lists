{
  "name": "@comicrelief/country-lists",
  "version": "1.0.0",
  "description": "Lists of countries for our frontend components",
  "author": "Comic Relief",
  "license": "MIT",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comicrelief/country-lists.git"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "npm run clean && npm run build",
    "build": "tsc -p tsconfig-build.json",
    "clean": "rm -rf dist",
    "lint": "eslint src tests",
    "mocha": "mocha --require ts-node/register",
    "test": "npm run mocha -- 'tests/**/*.spec.ts'",
    "coverage": "nyc npm test"
  },
  "devDependencies": {
    "@comicrelief/eslint-config": "^1.4.0",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/chai": "^4.3.20",
    "@types/country-list": "^2.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.20",
    "@typescript-eslint/eslint-plugin": "^5.30.4",
    "@typescript-eslint/parser": "^5.30.4",
    "chai": "^4.5.0",
    "eslint": "^8.19.0",
    "mocha": "^11.7.6",
    "nyc": "^18.0.0",
    "semantic-release": "^25.0.5",
    "ts-node": "^10.8.2",
    "tsconfig-paths": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "country-list": "^2.2.0"
  }
}
